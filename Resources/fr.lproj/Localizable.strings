/* Messages d’erreur */
"macFUSE is not installed. Install it from macfuse.github.io (Mimiq installs it too), then try again." = "macFUSE n’est pas installé. Installez-le depuis macfuse.github.io (Mimiq l’installe aussi), puis réessayez.";
"Another drive named “%@” is already connected. Eject it first – two volumes cannot have the same name." = "Un autre disque nommé « %@ » est déjà connecté. Éjectez-le d’abord – deux volumes ne peuvent pas porter le même nom.";
"macFUSE could not be loaded. Allow its system extension under System Settings → Privacy & Security, restart the Mac and try again." = "Impossible de charger macFUSE. Autorisez son extension système dans Réglages Système → Confidentialité et sécurité, redémarrez le Mac et réessayez.";
"Mountpoint is not allowed to read the folder of “%@”. Check the folder’s permissions or allow Mountpoint under System Settings → Privacy & Security → Files and Folders." = "Mountpoint n’a pas le droit de lire le dossier de « %@ ». Vérifiez les autorisations du dossier ou autorisez Mountpoint dans Réglages Système → Confidentialité et sécurité → Fichiers et dossiers.";
"Details: %@" = "Détails : %@";
"“%@” could not be ejected." = "Impossible d’éjecter « %@ ».";
"Mountpoint’s helper program could not be started. Please reinstall Mountpoint." = "Le programme d’aide de Mountpoint n’a pas pu démarrer. Veuillez réinstaller Mountpoint.";
"The folder “%@” was not found on the NAS share %@%@. It may have been moved or renamed." = "Le dossier « %@ » est introuvable sur le partage NAS %@%@. Il a peut-être été déplacé ou renommé.";
"The drive “%@” is not connected. Connect it and try again." = "Le disque « %@ » n’est pas connecté. Connectez-le et réessayez.";
"The folder “%@” no longer exists. It may have been moved or renamed: %@" = "Le dossier « %@ » n’existe plus. Il a peut-être été déplacé ou renommé : %@";
"Connecting to “%@” was cancelled." = "La connexion à « %@ » a été annulée.";
"The NAS “%@” rejected the login. Check user name and password – Mountpoint uses the ones saved in the Keychain." = "Le NAS « %@ » a refusé la connexion. Vérifiez le nom d’utilisateur et le mot de passe – Mountpoint utilise ceux enregistrés dans le trousseau.";
"The share “%@” does not exist on “%@”." = "Le partage « %@ » n’existe pas sur « %@ ».";
